# ---------------------------------------------------------------------------
# Wildflower Mail — environment variables
# Copy this file to .env.local for local development, and add the same
# values (with real, non-test keys where appropriate) to your Vercel/hosting
# project settings before deploying.
# NEVER commit .env.local or paste real secret keys into source control.
# ---------------------------------------------------------------------------

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (use TEST mode keys until launch has been fully verified) ---
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Price IDs are created in the Stripe Dashboard (Products) and referenced
# here rather than hard-coded, so prices can change without a redeploy.
STRIPE_PRICE_MONTHLY_MEMBERSHIP=price_placeholder_monthly
STRIPE_PRICE_GIFT_THREE_MONTH=price_placeholder_gift3
STRIPE_PRICE_GIFT_SIX_MONTH=price_placeholder_gift6

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder_anon_key
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key_keep_server_only

# --- Resend (transactional email) ---
RESEND_API_KEY=re_placeholder
RESEND_FROM_ADDRESS="Wildflower Mail <hello@wildflowermail.com>"

# --- Marketing email platform (prepared for later use; leave blank until connected) ---
NEWSLETTER_PROVIDER_API_KEY=
NEWSLETTER_PROVIDER_LIST_ID=

# --- Admin auth ---
# Simple shared-password gate for the MVP admin dashboard (see README for
# upgrade path to per-admin Supabase accounts).
ADMIN_PASSWORD=change_me_before_launch
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string

# --- Analytics (disabled until IDs are supplied) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
